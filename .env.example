# PIN de 6 dígitos para entrar a /panel
PANEL_PIN=
# Cadena aleatoria de 32+ caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Emails por SMTP (ej. Zoho Mail). Si están las cuatro, los emails salen por acá
# (desde un dominio con SPF/DKIM). Ver docs/handoff-email-zoho.md
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Dirección que ve el destinatario (puede ser un alias de SMTP_USER)
EMAIL_FROM=

# Google Sheets. Con Supabase configurado, solo se usa para mandar los emails
# (MailApp) cuando no hay SMTP. Ver google-sheets/README.md
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_SECRET=

# Supabase (Project Settings > API keys: URL y una secret key). Si está, guarda
# reservas, bloqueos y prospectos de las demos en lugar de la planilla.
# Sin Sheets ni Supabase, en desarrollo se guarda en .data/
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Dirección pública del sitio, para los links de los emails (ej. https://peluqueriaramirez.com.uy).
# Si falta, se usa la del pedido.
SITIO_URL=

# Solo en el sitio de demos de la agencia: habilita /demo/<slug> (ver demos/README.md)
DEMOS=

# Webhook de n8n que recibe cada reserva y cancelación (opcional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
